{ lib, config, pkgs, ... }:

let
  cfg = config.modules.git;
  access = cfg.sshAccess;
  identityType = lib.types.submodule {
    options = {
      publicKey = lib.mkOption {
        type = lib.types.str;
        description = "Exact forwarded SSH public key (comments are ignored).";
      };
      wrappedKey = lib.mkOption {
        type = lib.types.nullOr lib.types.str;
        default = null;
        description = "Agenix runtime path containing the inner age-wrapped publication key; null uses the forwarded identity directly.";
      };
      ageIdentity = lib.mkOption {
        type = lib.types.nullOr lib.types.str;
        default = null;
        description = "Public wrapping metadata generated by git-ssh-access wrap-keygen using the approved Ed25519 source key.";
      };
      publicationPublicKey = lib.mkOption {
        type = lib.types.nullOr lib.types.str;
        default = null;
        description = "Expected SSH public key of the wrapped GitHub credential.";
      };
    };
  };
  forwardingSsh = pkgs.writeShellScript "git-forward-ssh" ''
    exec ${helper}/bin/git-ssh-access transport ${lib.escapeShellArgs ([
      config.home.homeDirectory
      "${pkgs.openssh}/bin/ssh"
      "${pkgs.openssh}/bin/ssh-agent"
    ] ++ lib.concatMap (identity: [
      (toString (pkgs.writeText "git-forward-source.pub" (identity.publicKey + "\n")))
      (if identity.wrappedKey == null then "" else identity.wrappedKey)
      (if identity.ageIdentity == null then "" else toString (pkgs.writeText "git-forward-age-identity" (identity.ageIdentity + "\n")))
      (if identity.publicationPublicKey == null then "" else toString (pkgs.writeText "git-forward-publication.pub" (identity.publicationPublicKey + "\n")))
    ]) access.forwardingIdentities)} -- "$@"
  '';
  helper = pkgs.callPackage ./git-ssh-access/package.nix { };
  preReceive = pkgs.writeShellScript "git-ssh-pre-receive" ''
    exec ${helper}/bin/git-ssh-access check ${pkgs.git}/bin/git ${lib.escapeShellArgs access.allowedPushPrefixes}
  '';
  hooks = pkgs.runCommand "git-ssh-hooks" { } ''
    mkdir -p $out
    ln -s ${preReceive} $out/pre-receive
  '';
  command = lib.escapeShellArgs [
    "${helper}/bin/git-ssh-access"
    config.home.homeDirectory
    cfg.directory
    "${pkgs.git}/bin/git"
    (toString hooks)
    (lib.boolToString access.allowPush)
    (toString forwardingSsh)
  ] + " " + lib.escapeShellArgs access.allowedPushPrefixes;
  quotedCommand = lib.replaceStrings [ "\\" "\"" ] [ "\\\\" "\\\"" ] command;
in {
  options.modules.git.sshAccess = {
    enable = lib.mkEnableOption "Git-only SSH access to repositories beneath modules.git.directory";

    authorizedKeys = lib.mkOption {
      default = [ ];
      apply = lib.unique;
      type = lib.types.listOf (lib.types.strMatching "(ssh-[^ \r\n]+|ecdsa-[^ \r\n]+|sk-[^ \r\n]+) [A-Za-z0-9+/=]+( [^\r\n]*)?");
      description = ''
        Public SSH keys granted Git-only access to repositories beneath modules.git.directory.
        Repository paths retain normal SSH semantics: relative to the account's
        home directory, or absolute. Paths are validated, never remapped.
        Resolved repository paths inside dot directories beneath the Git root
        are excluded.
        Do not include authorized_keys options. These restrictions apply to OpenSSH;
        Tailscale SSH has separate authorization and does not enforce them.
        Entries are merged into modules.ssh.authorizedKeys.
      '';
    };

    allowPush = lib.mkOption {
      default = true;
      type = lib.types.bool;
      description = "Whether these keys may receive and forward branches in existing repositories. Checked-out branches remain protected; only the managed policy hook runs.";
    };

    forwardingIdentities = lib.mkOption {
      default = [ ];
      type = lib.types.listOf identityType;
      description = ''
        Explicit identities usable for onward GitHub publication. Exactly one
        configured identity must be present in the forwarded agent. Wrapped
        credentials require an ordinary Ed25519 source identity, public wrapping
        metadata, and the expected publication public key. No local credential
        fallback is allowed. See git-forwarding.md for agenix provisioning.
      '';
    };

    allowedPushPrefixes = lib.mkOption {
      default = [ "@kitten/" "@kitten-agent/" ];
      type = lib.types.listOf (lib.types.strMatching "[A-Za-z0-9@._/-]+/");
      description = "Literal branch name prefixes writable through Git SSH access. An empty list denies all ref updates. Tags and deletions are always denied.";
    };
  };

  config = lib.mkIf (cfg.enable && access.enable) {
    home.packages = [ helper ];
    assertions = map (identity: {
      assertion = if identity.wrappedKey == null then
        identity.ageIdentity == null && identity.publicationPublicKey == null
      else
        lib.hasPrefix "/" identity.wrappedKey
        && !(lib.hasPrefix "/nix/store/" identity.wrappedKey)
        && lib.hasPrefix "ssh-ed25519 " identity.publicKey
        && identity.ageIdentity != null
        && lib.hasPrefix "AGE-PLUGIN-SSHAGENT-1" identity.ageIdentity
        && identity.publicationPublicKey != null;
      message = "git.sshAccess.forwardingIdentities: wrapped keys need a runtime path, Ed25519 source, plugin identity, and publication public key; direct identities must omit wrapping fields.";
    }) access.forwardingIdentities;
    modules.ssh.authorizedKeys = map
      (key: ''restrict${lib.optionalString (access.forwardingIdentities != [ ]) ",agent-forwarding"},command="${quotedCommand}" ${key}'') access.authorizedKeys;
  };
}
